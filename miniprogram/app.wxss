/* 全局深色峡谷主题 */
page {
  background: linear-gradient(180deg, #0b1530 0%, #111c3d 100%);
  color: #e6ebf5;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  min-height: 100vh;
}

view, text, image, scroll-view, swiper {
  box-sizing: border-box;
}

/* 通用容器 */
.container { padding: 24rpx; }
.row { display: flex; flex-direction: row; align-items: center; }
.col { display: flex; flex-direction: column; }
.center { display: flex; justify-content: center; align-items: center; }
.between { display: flex; justify-content: space-between; align-items: center; }

/* 卡片 */
.card {
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.25);
  border: 1rpx solid rgba(255,214,110,0.08);
}
.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffd66e;
  margin-bottom: 12rpx;
}
.card-sub {
  font-size: 24rpx;
  color: #8a93a6;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 24rpx;
  background: rgba(255,214,110,0.15);
  color: #ffd66e;
  margin-right: 12rpx;
}
.tag-blue { background: rgba(94,170,255,0.15); color: #5eaaff; }
.tag-red { background: rgba(255,107,107,0.15); color: #ff6b6b; }
.tag-green { background: rgba(95,217,167,0.15); color: #5fd9a7; }

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #ffd66e 0%, #f6a23a 100%);
  color: #0b1530;
  font-weight: bold;
  border-radius: 48rpx;
  padding: 18rpx 48rpx;
  font-size: 28rpx;
}

/* 段标题 */
.section-title {
  display: flex;
  align-items: center;
  margin: 24rpx 0 16rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}
.section-title::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  background: #ffd66e;
  margin-right: 12rpx;
  border-radius: 4rpx;
}
.section-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #8a93a6;
}

/* 评分星 */
.rate { color: #ffd66e; }

/* 占位图 */
.placeholder-img {
  background: linear-gradient(135deg, #1a2547, #2a3a6b);
}

/* 滚动横向 */
.h-scroll {
  white-space: nowrap;
  overflow-x: auto;
}
.h-scroll::-webkit-scrollbar { display: none; }

/* hero 卡片 */
.hero-card {
  width: 200rpx;
  margin-right: 16rpx;
  display: inline-block;
  text-align: center;
  vertical-align: top;
}
.hero-card image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #1a2547;
}
.hero-name { font-size: 26rpx; margin-top: 8rpx; color: #fff; }
.hero-role { font-size: 22rpx; color: #8a93a6; }

/* 视频缩略 */
.video-thumb {
  width: 100%;
  height: 360rpx;
  background: #1a2547;
  border-radius: 16rpx;
  position: relative;
  overflow: hidden;
}
.video-duration {
  position: absolute; right: 12rpx; bottom: 12rpx;
  background: rgba(0,0,0,0.6); color: #fff;
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
}
.video-play {
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%,-50%);
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: rgba(255,214,110,0.85);
  display: flex; justify-content: center; align-items: center;
  color: #0b1530; font-size: 40rpx;
}

.header-name { color: #ffd66e; font-size: 32rpx; font-weight: bold; padding: 12rpx 0 24rpx 0; }
.build-card { background: rgba(255,255,255,0.05); border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; border: 1rpx solid rgba(255,214,110,0.08); }
.bc-name { color: #fff; font-size: 30rpx; font-weight: bold; }
.bc-stat { color: #5fd9a7; font-size: 24rpx; margin-right: 24rpx; }

.items { display: flex; justify-content: space-between; margin: 20rpx 0; flex-wrap: wrap; }
.item-cell { width: 16%; display: flex; flex-direction: column; align-items: center; }
.item-icon { width: 88rpx; height: 88rpx; border-radius: 16rpx; }
.item-name { color: #cdd5e3; font-size: 22rpx; margin-top: 6rpx; text-align: center; line-height: 1.3; }

.info-line { color: #cdd5e3; font-size: 26rpx; margin-top: 8rpx; }
.il-key { color: #8a93a6; }
.il-val { color: #fff; }
.tips { margin-top: 16rpx; padding: 16rpx; background: rgba(255,214,110,0.08); border-left: 4rpx solid #ffd66e; color: #ffd66e; font-size: 24rpx; line-height: 1.7; border-radius: 8rpx; }

<view class="page">
  <view class="search-bar">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索英雄名" placeholder-class="ph" bindinput="onSearch" />
    </view>
  </view>
  <scroll-view scroll-x class="role-bar">
    <view wx:for="{{roles}}" wx:key="*this"
      class="role-tab {{role===item?'active':''}}"
      data-role="{{item}}" bindtap="selectRole">{{item}}</view>
  </scroll-view>

  <view class="container">
    <view class="grid">
      <view wx:for="{{filtered}}" wx:key="id" class="hero-grid" data-id="{{item.id}}" bindtap="goHero">
        <image class="placeholder-img" src="{{item.avatar}}" mode="aspectFill" />
        <view class="hg-name">{{item.name}}</view>
        <view class="hg-role">{{item.role}}</view>
      </view>
    </view>
    <view wx:if="{{!filtered.length}}" class="empty">没有符合条件的英雄</view>
  </view>
</view>

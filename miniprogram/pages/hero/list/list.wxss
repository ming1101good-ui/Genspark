.search-bar { padding: 16rpx 24rpx; }
.search-box { background: rgba(255,255,255,0.08); border-radius: 40rpx; padding: 0 24rpx; display: flex; align-items: center; height: 72rpx; }
.search-icon { color: #8a93a6; margin-right: 12rpx; }
.search-input { flex: 1; color: #fff; font-size: 28rpx; }
.ph { color: #6c7589; }

.role-bar { white-space: nowrap; padding: 12rpx 24rpx 0 24rpx; }
.role-tab { display: inline-block; padding: 14rpx 28rpx; margin-right: 12rpx; border-radius: 32rpx; background: rgba(255,255,255,0.05); color: #cdd5e3; font-size: 26rpx; }
.role-tab.active { background: linear-gradient(135deg, #ffd66e 0%, #f6a23a 100%); color: #0b1530; font-weight: bold; }

.grid { display: flex; flex-wrap: wrap; }
.hero-grid { width: 25%; box-sizing: border-box; padding: 12rpx; text-align: center; }
.hero-grid image { width: 152rpx; height: 152rpx; border-radius: 16rpx; }
.hg-name { color: #fff; font-size: 26rpx; margin-top: 8rpx; }
.hg-role { color: #8a93a6; font-size: 22rpx; }
.empty { color: #8a93a6; text-align: center; padding: 60rpx 0; }

.big-cover { width: 100%; height: 720rpx; position: relative; background: linear-gradient(135deg, #1a2547, #2a3a6b); }
.cover-mask { position: absolute; inset: 0; background: linear-gradient(to top, #0b1530, transparent 50%); }
.skin-info { position: absolute; left: 24rpx; right: 24rpx; bottom: 32rpx; }
.s-quality { display: inline-block; }
.s-name { color: #fff; font-size: 48rpx; font-weight: bold; margin-top: 8rpx; }
.s-desc { color: #cdd5e3; font-size: 26rpx; margin-top: 8rpx; }

.thumbs { white-space: nowrap; padding: 24rpx; }
.thumb { display: inline-block; width: 168rpx; margin-right: 16rpx; vertical-align: top; }
.thumb .t-img { width: 168rpx; height: 168rpx; border-radius: 16rpx; border: 4rpx solid transparent; }
.thumb.active .t-img { border-color: #ffd66e; }
.t-name { display: block; color: #cdd5e3; font-size: 22rpx; margin-top: 6rpx; text-align: center; }

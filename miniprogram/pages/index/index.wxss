.page { padding-bottom: 60rpx; }

.search-bar { padding: 16rpx 24rpx; }
.search-box {
  background: rgba(255,255,255,0.08);
  border-radius: 40rpx; padding: 0 24rpx;
  display: flex; align-items: center; height: 72rpx;
}
.search-icon { color: #8a93a6; margin-right: 12rpx; }
.search-input { flex: 1; color: #fff; font-size: 28rpx; }
.ph { color: #6c7589; }

.banner { width: 702rpx; height: 280rpx; margin: 8rpx 24rpx; border-radius: 20rpx; overflow: hidden; }
.banner-item { width: 100%; height: 100%; position: relative; }
.banner-img { width: 100%; height: 100%; display: block; }
.banner-mask { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.65), transparent 60%); }
.banner-title { position: absolute; left: 24rpx; bottom: 24rpx; right: 24rpx; color: #fff; font-size: 30rpx; font-weight: bold; }

.channels { display: flex; justify-content: space-around; padding: 24rpx; }
.ch { display: flex; flex-direction: column; align-items: center; font-size: 24rpx; color: #cdd5e3; }
.ch-icon {
  width: 96rpx; height: 96rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; margin-bottom: 8rpx;
  background: linear-gradient(135deg, rgba(255,214,110,0.18), rgba(246,162,58,0.12));
  border: 1rpx solid rgba(255,214,110,0.25);
}
.ch-2 { background: linear-gradient(135deg, rgba(94,170,255,0.2), rgba(94,170,255,0.08)); border-color: rgba(94,170,255,0.3); }
.ch-3 { background: linear-gradient(135deg, rgba(255,107,107,0.2), rgba(255,107,107,0.08)); border-color: rgba(255,107,107,0.3); }
.ch-4 { background: linear-gradient(135deg, rgba(95,217,167,0.2), rgba(95,217,167,0.08)); border-color: rgba(95,217,167,0.3); }
.ch-5 { background: linear-gradient(135deg, rgba(192,148,255,0.2), rgba(192,148,255,0.08)); border-color: rgba(192,148,255,0.3); }

.match-card {
  background: rgba(255,255,255,0.05);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(255,214,110,0.08);
}
.match-stage { font-size: 24rpx; color: #8a93a6; margin-bottom: 16rpx; }
.match-body { display: flex; align-items: center; justify-content: space-between; }
.match-team { display: flex; flex-direction: column; align-items: center; flex: 1; }
.team-logo { width: 96rpx; height: 96rpx; border-radius: 50%; margin-bottom: 8rpx; }
.team-name { font-size: 26rpx; color: #fff; }
.match-vs { display: flex; flex-direction: column; align-items: center; padding: 0 16rpx; }
.match-vs-text { color: #ffd66e; font-size: 32rpx; font-weight: bold; }
.match-score { color: #ffd66e; font-size: 36rpx; font-weight: bold; }
.match-status { color: #8a93a6; font-size: 22rpx; margin-top: 8rpx; }

.video-card { width: 360rpx; display: inline-block; margin-right: 16rpx; vertical-align: top; }
.video-card .video-thumb { height: 220rpx; }
.video-title {
  font-size: 26rpx; color: #fff; margin-top: 12rpx;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
  overflow: hidden;
}
.video-author { font-size: 22rpx; color: #8a93a6; margin-top: 6rpx; }
.empty-tip { color: #8a93a6; padding: 32rpx; font-size: 26rpx; text-align: center; }

.combo-rune {
  display: inline-block; font-size: 24rpx; margin: 6rpx 8rpx 0 0;
  padding: 4rpx 14rpx; border-radius: 12rpx;
  background: rgba(94,170,255,0.12); color: #5eaaff;
}

.footer-tip { text-align: center; color: #6c7589; font-size: 22rpx; padding: 32rpx; }

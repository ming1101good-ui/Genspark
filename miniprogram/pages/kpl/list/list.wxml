<view class="page">
  <view class="season">{{season}}</view>
  <view class="tabs">
    <view class="tab {{tab==='schedule'?'active':''}}" data-tab="schedule" bindtap="switchTab">赛程</view>
    <view class="tab {{tab==='rank'?'active':''}}" data-tab="rank" bindtap="switchTab">积分榜</view>
    <view class="tab {{tab==='team'?'active':''}}" data-tab="team" bindtap="switchTab">战队</view>
    <view class="tab {{tab==='news'?'active':''}}" data-tab="news" bindtap="switchTab">资讯</view>
  </view>

  <!-- 赛程 -->
  <block wx:if="{{tab==='schedule'}}">
    <view class="container">
      <view wx:for="{{schedule}}" wx:key="id" class="match-card" data-id="{{item.id}}" bindtap="goMatch">
        <view class="match-stage">{{item.stage}} · {{item.date}}</view>
        <view class="match-body">
          <view class="match-team">
            <view class="team-logo placeholder-img"></view>
            <text class="team-name">{{item.teamA}}</text>
          </view>
          <view class="match-vs">
            <text wx:if="{{item.score}}" class="match-score">{{item.score}}</text>
            <text wx:else class="match-vs-text">VS</text>
            <text class="match-status">{{item.status}}</text>
          </view>
          <view class="match-team">
            <view class="team-logo placeholder-img"></view>
            <text class="team-name">{{item.teamB}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 积分榜 -->
  <block wx:if="{{tab==='rank'}}">
    <view class="container">
      <view class="rank-head row">
        <text style="width:80rpx;">排名</text>
        <text style="flex:1;">战队</text>
        <text style="width:100rpx;text-align:center;">胜</text>
        <text style="width:100rpx;text-align:center;">负</text>
        <text style="width:100rpx;text-align:right;">积分</text>
      </view>
      <view wx:for="{{rank}}" wx:key="rank" class="rank-row row">
        <text class="rank-num {{item.rank<=3?'top':''}}" style="width:80rpx;">{{item.rank}}</text>
        <text style="flex:1;color:#fff;">{{item.team}}</text>
        <text style="width:100rpx;text-align:center;color:#5fd9a7;">{{item.win}}</text>
        <text style="width:100rpx;text-align:center;color:#ff6b6b;">{{item.lose}}</text>
        <text style="width:100rpx;text-align:right;color:#ffd66e;font-weight:bold;">{{item.score}}</text>
      </view>
    </view>
  </block>

  <!-- 战队 -->
  <block wx:if="{{tab==='team'}}">
    <view class="container">
      <view wx:for="{{teams}}" wx:key="id" class="team-card" data-id="{{item.id}}" bindtap="goTeam">
        <view class="team-logo-big placeholder-img"></view>
        <view style="flex:1;">
          <view class="team-card-name">{{item.name}}</view>
          <view class="team-card-area">主场：{{item.area}}</view>
          <view class="team-card-record">
            <text class="tag tag-green">{{item.win}}胜</text>
            <text class="tag tag-red">{{item.lose}}负</text>
          </view>
        </view>
        <text class="arrow">›</text>
      </view>
    </view>
  </block>

  <!-- 资讯 -->
  <block wx:if="{{tab==='news'}}">
    <view class="container">
      <view wx:for="{{news}}" wx:key="id" class="news-card">
        <view class="news-title">{{item.title}}</view>
        <view class="news-date">{{item.date}}</view>
      </view>
    </view>
  </block>
</view>

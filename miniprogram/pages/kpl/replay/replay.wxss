.data-row { display: flex; justify-content: space-between; padding: 14rpx 0; color: #cdd5e3; font-size: 26rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.data-row:last-child { border: 0; }
.data-row .val { color: #ffd66e; }

.timeline { display: flex; align-items: flex-start; padding: 14rpx 0; position: relative; }
.timeline-dot { width: 16rpx; height: 16rpx; background: #ffd66e; border-radius: 50%; margin-top: 12rpx; margin-right: 20rpx; flex-shrink: 0; box-shadow: 0 0 0 6rpx rgba(255,214,110,0.15); }
.timeline-content { flex: 1; }
.t-time { display: inline-block; color: #5eaaff; font-size: 24rpx; margin-right: 12rpx; }
.t-desc { color: #cdd5e3; font-size: 26rpx; }

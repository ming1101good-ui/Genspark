.page {
  min-height: 100vh;
  background-color: #0b1530;
  color: #fff;
  padding-bottom: 40rpx;
  box-sizing: border-box;
}

.search-bar {
  padding: 20rpx 30rpx;
  background-color: #141f3e;
  position: sticky;
  top: 0;
  z-index: 100;
}
.search-box {
  background: #1c2a52;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 72rpx;
}
.search-icon {
  font-size: 28rpx;
  color: #8a93a6;
  margin-right: 12rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #fff;
}
.ph {
  color: #8a93a6;
}

.loading, .empty {
  text-align: center;
  padding: 100rpx 0;
  color: #8a93a6;
  font-size: 28rpx;
}

.container {
  margin: 30rpx;
  background: #141f3e;
  border-radius: 20rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
  color: #ffd66e;
}

.h-scroll {
  white-space: nowrap;
}

.hero-card, .item-card {
  display: inline-block;
  width: 140rpx;
  margin-right: 24rpx;
  text-align: center;
}
.hero-card:last-child, .item-card:last-child {
  margin-right: 0;
}
.hero-card image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-bottom: 12rpx;
}
.hero-name, .item-name {
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-role {
  font-size: 22rpx;
  color: #8a93a6;
  margin-top: 4rpx;
}
.item-price {
  font-size: 22rpx;
  color: #ffd66e;
  margin-top: 4rpx;
}

.video-card {
  display: inline-block;
  width: 320rpx;
  margin-right: 24rpx;
}
.video-card:last-child {
  margin-right: 0;
}
.video-thumb {
  width: 100%;
  height: 180rpx;
  border-radius: 16rpx;
  position: relative;
  margin-bottom: 12rpx;
}
.video-duration {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0,0,0,0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}
.video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  color: #fff;
  font-size: 40rpx;
  opacity: 0.8;
}
.video-title {
  font-size: 26rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
}
.video-author {
  font-size: 22rpx;
  color: #8a93a6;
}

.card {
  background: #1c2a52;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card:last-child {
  margin-bottom: 0;
}
.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.card-title {
  font-size: 30rpx;
  font-weight: bold;
}
.card-sub {
  font-size: 24rpx;
  color: #8a93a6;
}
.row {
  display: flex;
  align-items: center;
}
.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  background: #2a3a6a;
  color: #aeb8d0;
}
.tag-red {
  background: rgba(255, 100, 100, 0.15);
  color: #ff6b6b;
}
.tag-blue {
  background: rgba(100, 150, 255, 0.15);
  color: #6ba4ff;
}
.rune-cell { display: flex; align-items: center; padding: 14rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.05); }
.rune-cell:last-child { border: 0; }
.rc-icon { width: 80rpx; height: 80rpx; border-radius: 16rpx; margin-right: 18rpx; }
.rc-name { color: #fff; font-size: 28rpx; }
.rc-detail { color: #ffd66e; font-size: 22rpx; margin-top: 4rpx; }

.attr-row { display: flex; justify-content: space-between; padding: 10rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.attr-row:last-child { border: 0; }
.ak { color: #cdd5e3; font-size: 26rpx; }
.av { color: #ffd66e; font-size: 26rpx; font-weight: bold; }

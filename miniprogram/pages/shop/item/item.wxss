.header { display: flex; padding: 32rpx 24rpx; background: linear-gradient(135deg,#1a2547,#2a3a6b); align-items: center; }
.big-icon { width: 160rpx; height: 160rpx; border-radius: 20rpx; margin-right: 24rpx; }
.info { flex: 1; }
.i-name { color: #fff; font-size: 38rpx; font-weight: bold; }

.attr-row { display: flex; justify-content: space-between; padding: 12rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.attr-row:last-child { border: 0; }
.ak { color: #cdd5e3; font-size: 26rpx; }
.av { color: #ffd66e; font-size: 26rpx; font-weight: bold; }

.tree { color: #cdd5e3; font-size: 26rpx; padding: 8rpx 0; }
.tips { margin-top: 16rpx; padding: 18rpx; background: rgba(255,214,110,0.1); border-left: 4rpx solid #ffd66e; color: #ffd66e; font-size: 24rpx; line-height: 1.7; border-radius: 8rpx; }

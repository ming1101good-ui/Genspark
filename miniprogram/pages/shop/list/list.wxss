.tabs { display: flex; padding: 0 24rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.tab { padding: 20rpx 24rpx; color: #8a93a6; font-size: 28rpx; position: relative; margin-right: 16rpx; }
.tab.active { color: #ffd66e; font-weight: bold; }
.tab.active::after { content: ''; position: absolute; left: 24rpx; right: 24rpx; bottom: 0; height: 4rpx; background: #ffd66e; border-radius: 2rpx; }

.cat-bar { white-space: nowrap; padding: 16rpx 24rpx 0; }
.cat { display: inline-block; padding: 12rpx 24rpx; margin-right: 12rpx; border-radius: 32rpx; background: rgba(255,255,255,0.05); color: #cdd5e3; font-size: 26rpx; }
.cat.active { background: linear-gradient(135deg, #ffd66e, #f6a23a); color: #0b1530; font-weight: bold; }

.grid { display: flex; flex-wrap: wrap; }
.g-item { width: 25%; box-sizing: border-box; padding: 12rpx; text-align: center; }
.g-icon { width: 144rpx; height: 144rpx; border-radius: 16rpx; margin: 0 auto; }
.g-name { color: #fff; font-size: 24rpx; margin-top: 6rpx; }
.g-price { color: #ffd66e; font-size: 22rpx; }

.rune-row { display: flex; align-items: center; background: rgba(255,255,255,0.05); border-radius: 16rpx; padding: 20rpx; margin-bottom: 14rpx; }
.r-icon { width: 88rpx; height: 88rpx; border-radius: 16rpx; margin-right: 18rpx; }
.r-红色 { background: linear-gradient(135deg, rgba(255,107,107,0.4), #4a1a1a); }
.r-蓝色 { background: linear-gradient(135deg, rgba(94,170,255,0.4), #1a2a4a); }
.r-绿色 { background: linear-gradient(135deg, rgba(95,217,167,0.4), #1a4a30); }
.r-name { color: #fff; font-size: 30rpx; font-weight: bold; }
.r-desc { color: #cdd5e3; font-size: 24rpx; margin-top: 4rpx; }
.r-tag { margin-left: 12rpx; }

.combo-rune { display: inline-block; font-size: 24rpx; margin: 6rpx 8rpx 0 0; padding: 4rpx 14rpx; border-radius: 12rpx; background: rgba(94,170,255,0.12); color: #5eaaff; }

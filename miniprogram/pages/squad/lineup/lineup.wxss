.phase { padding: 12rpx 0; border-left: 4rpx solid #ffd66e; padding-left: 20rpx; margin-left: 8rpx; margin-bottom: 16rpx; }
.ph-tag { color: #ffd66e; font-size: 26rpx; font-weight: bold; }
.ph-desc { color: #cdd5e3; font-size: 26rpx; margin-top: 6rpx; line-height: 1.7; }

.tip-row { display: flex; align-items: flex-start; padding: 10rpx 0; }
.t-num { width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; background: rgba(255,214,110,0.2); color: #ffd66e; border-radius: 50%; font-size: 22rpx; margin-right: 14rpx; flex-shrink: 0; }
.t-text { color: #cdd5e3; font-size: 26rpx; flex: 1; line-height: 1.7; }

.syn { padding: 12rpx 0; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.syn:last-child { border: 0; }
.syn-line { font-size: 28rpx; }
.from { color: #5eaaff; font-weight: bold; }
.arrow { color: #8a93a6; margin: 0 12rpx; }
.to { color: #5fd9a7; font-weight: bold; }
.effect { color: #cdd5e3; font-size: 24rpx; display: block; margin-top: 6rpx; line-height: 1.6; }

.banner-tip { margin: 16rpx 24rpx; padding: 18rpx 24rpx; background: rgba(255,214,110,0.1); border-radius: 16rpx; color: #ffd66e; font-size: 24rpx; line-height: 1.6; border-left: 4rpx solid #ffd66e; }

.tabs { display: flex; padding: 0 24rpx; border-bottom: 1rpx solid rgba(255,255,255,0.06); }
.tab { padding: 20rpx 24rpx; color: #8a93a6; font-size: 28rpx; position: relative; margin-right: 16rpx; }
.tab.active { color: #ffd66e; font-weight: bold; }
.tab.active::after { content: ''; position: absolute; left: 24rpx; right: 24rpx; bottom: 0; height: 4rpx; background: #ffd66e; border-radius: 2rpx; }

.squad-card { background: rgba(255,255,255,0.05); border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; border: 1rpx solid rgba(255,214,110,0.08); }
.hero-line { display: flex; justify-content: space-between; margin-top: 20rpx; }
.h-cell { display: flex; flex-direction: column; align-items: center; flex: 1; }
.h-icon { width: 96rpx; height: 96rpx; border-radius: 16rpx; }
.h-name { color: #cdd5e3; font-size: 22rpx; margin-top: 8rpx; }
.bottom-row { margin-top: 20rpx; padding-top: 16rpx; border-top: 1rpx solid rgba(255,255,255,0.06); }
.rate { color: #5fd9a7; font-size: 26rpx; }
.more { color: #ffd66e; font-size: 26rpx; }

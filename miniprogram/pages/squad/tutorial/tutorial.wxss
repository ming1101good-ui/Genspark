.video-list-card { background: rgba(255,255,255,0.05); border-radius: 20rpx; margin-bottom: 20rpx; overflow: hidden; }
.vlc-thumb { width: 100%; height: 360rpx; border-radius: 16rpx 16rpx 0 0; position: relative; }
.vlc-body { padding: 20rpx; }
.vlc-title { color: #fff; font-size: 28rpx; line-height: 1.5; }
.vlc-author { color: #8a93a6; font-size: 24rpx; margin-top: 6rpx; }
.vlc-views { color: #5eaaff; font-size: 22rpx; margin-top: 4rpx; }

.header { display: flex; padding: 32rpx 24rpx; background: linear-gradient(135deg,#1a2547,#2a3a6b); }
.avatar { width: 144rpx; height: 144rpx; border-radius: 50%; margin-right: 24rpx; }
.info { flex: 1; }
.name { color: #fff; font-size: 38rpx; font-weight: bold; }
.meta { color: #8a93a6; font-size: 24rpx; margin-top: 8rpx; }
.desc { padding: 24rpx; color: #cdd5e3; font-size: 26rpx; line-height: 1.7; background: rgba(255,255,255,0.03); margin: 16rpx 24rpx; border-radius: 16rpx; }

.video-list-card { background: rgba(255,255,255,0.05); border-radius: 20rpx; margin-bottom: 20rpx; overflow: hidden; }
.vlc-thumb { width: 100%; height: 360rpx; border-radius: 16rpx 16rpx 0 0; position: relative; }
.vlc-body { padding: 20rpx; }
.vlc-title { color: #fff; font-size: 28rpx; line-height: 1.5; }
.vlc-views { color: #5eaaff; font-size: 22rpx; margin-top: 6rpx; }
